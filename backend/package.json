{
  "name": "booking-configuration-backend",
  "version": "1.0.0",
  "description": "REST API backend for the Booking Configuration system",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/**/*.test.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:ensure-user": "node scripts/ensure-mysql-user.js",
    "db:seed": "node seed.js",
    "db:seed:reset": "node seed.js --reset"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.23.2"
  }
}
