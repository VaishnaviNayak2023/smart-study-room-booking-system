# Root app configuration
NODE_ENV=development

# MySQL container configuration
MYSQL_DATABASE=booking_configuration
MYSQL_USER=booking_user
MYSQL_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_PORT=3306

# Backend
# PORT is the standard listen port. BACKEND_PORT is accepted as an alias
# (Compose / older local setups). Default: 5006.
PORT=5006
BACKEND_PORT=5006
APP_NAME=Booking Configuration
CLIENT_ORIGIN=http://localhost:9000
CORS_ORIGINS=http://localhost:9000
# Host for local (non-Docker) backend runs. Inside Compose, DB_HOST is
# overridden to the mysql service name via DOCKER_DB_HOST (default: mysql).
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booking_configuration
DB_USER=booking_user
DB_PASSWORD=change_me_strong_password
DOCKER_DB_HOST=mysql
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Development seed credentials (do not use real production secrets here)
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@local.test
SEED_USER_EMAIL=user@local.test
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_USER_PASSWORD=ChangeMe123!

# Frontend
VITE_API_URL=http://localhost:5006
VITE_APP_NAME=Booking Configuration
VITE_DEFAULT_CURRENCY=
FRONTEND_PORT=9000
